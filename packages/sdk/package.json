{
  "name": "@syncforge/sdk",
  "version": "0.1.0",
  "description": "Public TypeScript client SDK for SyncForge real-time collaboration infrastructure",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "package:inspect": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@syncforge/shared": "*",
    "@types/react": "^19.0.7",
    "@types/ws": "^8.5.14",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  }
}
