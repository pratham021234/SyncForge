# ==============================================================================
# SyncForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root directory and adjust values as needed.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=SyncForge
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. SyncForge Backend Service (apps/server)
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
SERVER_PUBLIC_URL=http://localhost:4000

# Allowed CORS origins (comma-separated list for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Request limits and timeouts
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. Database - PostgreSQL
# ------------------------------------------------------------------------------
# Host-accessible connection string (when connecting from your local machine/host):
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/syncforge_dev

# Container-to-container connection string (used when server runs in Docker):
# DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/syncforge_dev

DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. Cache & Distributed Coordination - Redis
# ------------------------------------------------------------------------------
# Host-accessible connection string (when connecting from local machine/host):
REDIS_URL=redis://localhost:6379

# Container-to-container connection string (used when server runs in Docker):
# REDIS_URL=redis://redis:6379

REDIS_CONNECT_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 5. SyncForge Frontend Web (apps/web)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ------------------------------------------------------------------------------
# 6. Authentication, Multi-Tenant Control Plane & Security (Phase 4)
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret key used for signing session JWTs and scoped room tokens (min 32 chars)
AUTH_SECRET=development_only_secret_change_in_production_min_32_chars

# Global cryptographic salt combined with API secret keys during SHA-256 verifier computation
API_KEY_SALT=development_only_salt_change_in_production

# Session cookie duration in seconds (default: 7 days = 604800s)
SESSION_TTL_SECONDS=604800

# Password reset token expiry in seconds (default: 1 hour = 3600s)
PASSWORD_RESET_TTL_SECONDS=3600
